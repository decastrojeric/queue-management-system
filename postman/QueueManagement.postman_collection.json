{
  "info": {
    "_postman_id": "qms-collection-001",
    "name": "Queue Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Generate Queue",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "{{authToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"appointment_id\": 123\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/queue/generate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "queue",
            "generate"
          ]
        }
      }
    },
    {
      "name": "Get Pending Queues",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "{{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/queue/pending",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "queue",
            "pending"
          ]
        }
      }
    },
    {
      "name": "Call Queue (set ongoing)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "{{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/queue/call/:id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "queue",
            "call",
            ":id"
          ]
        }
      }
    },
    {
      "name": "Get Ongoing Queues",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "{{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/queue/ongoing",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "queue",
            "ongoing"
          ]
        }
      }
    },
    {
      "name": "Complete Queue",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "{{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/queue/complete/:id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "queue",
            "complete",
            ":id"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "authToken",
      "value": "Bearer qms-secret-token"
    }
  ]
}
